rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global de Autenticação Segura (JWT assinado pelo Google)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Serviços Fiscais LC 116
    // Consulta pública liberada; Gravação estritamente restrita a usuários autenticados; Deleção terminantemente proibida
    match /servicos/{servicoId} {
      allow read: if true;
      allow create, update: if isAuthenticated() 
                            && request.resource.data.descricao is string 
                            && request.resource.data.descricao.size() > 0;
      allow delete: if false;
    }

    // Catálogo NBS
    // Consulta pública liberada; Gravação restrita; Deleção proibida
    match /nbs/{nbsId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
                            && request.resource.data.codigo is string 
                            && request.resource.data.descricao is string;
      allow delete: if false;
    }

    // Prefeituras Padrão Nacional
    // Consulta pública liberada; Gravação restrita; Deleção proibida
    match /prefeituras/{prefeituraId} {
      allow read: if true;
      allow create, update: if isAuthenticated()
                            && request.resource.data.cidade is string 
                            && request.resource.data.uf is string;
      allow delete: if false;
    }

    // Configurações e Segredos: 100% BLOQUEADO
    // Ninguém (nem autenticado, nem anônimo) pode ler ou escrever pela API da web
    match /config/{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Bloqueio padrão total para qualquer outra coleção não declarada
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
